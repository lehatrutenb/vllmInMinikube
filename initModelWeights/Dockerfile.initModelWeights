FROM python:3.12-slim-trixie

COPY --from=ghcr.io/astral-sh/uv:0.13.6 /uv /usr/local/bin/uv

RUN uv venv --python /usr/local/bin/python3 /opt/venv

COPY requirements.txt requirements.txt
RUN uv pip install --python /opt/venv -r requirements.txt \
    && rm requirements.txt

ENV PATH="/opt/venv/bin:${PATH}"

COPY download_model_weights.py /usr/local/bin/download_model_weights.py
RUN chmod 755 /usr/local/bin/download_model_weights.py \
    && useradd --no-create-home vllm \
    && mkdir /.hf_home && chown vllm:vllm /.hf_home

ENV HF_HOME=/.hf_home
ENV MODEL_ID
ENV MODELS_DIR
ENV FORCE_DOWNLOAD=0

USER vllm
ENTRYPOINT ["python", "/usr/local/bin/download_model_weights.py"]